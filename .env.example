# Video2PDF Environment Variables (MERN / TypeScript Edition)

# Backend Configuration
PORT=8000
HOST="0.0.0.0"
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# MongoDB Database Configuration
# Local Docker or local daemon: mongodb://localhost:27017/video2pdf
# Or your MongoDB Atlas connection string
# Note: The backend automatically operates with an in-memory fallback if MongoDB is not running!
MONGODB_URI="mongodb://localhost:27017/video2pdf"

# Storage
STORAGE_DIR="./storage"

# Frontend Configuration
VITE_API_BASE_URL="http://localhost:8000"
