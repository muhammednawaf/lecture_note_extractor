# =====================================================================
# Video2PDF Backend Environment Configuration
# =====================================================================

# Server Configuration
PORT=8000
HOST=0.0.0.0
NODE_ENV=development

# Authentication & Security
# CRITICAL: In production (NODE_ENV=production), JWT_SECRET MUST be set to a secure, high-entropy secret.
JWT_SECRET=replace_with_a_secure_random_64_char_hex_secret_in_production
REQUIRE_AUTH=false

# Database Configuration (Mongoose with automatic resilient in-memory fallback)
MONGODB_URI=mongodb://localhost:27017/video2pdf

# CORS Configuration (Comma-separated allowed client origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# File Storage Configuration
STORAGE_DIR=./storage

